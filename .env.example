# ==============================================================================
# 🌌 AetherOS (OpenDots) — Sovereign Node Configuration
# ==============================================================================

# Server Ports
AETHER_PORT=4099
AETHER_WEB_PORT=3000

# Model Gateway Configuration (Cascading Failover Enabled)
# You can leave cloud keys empty to run in offline local mode via Ollama or Mock mode.

# 1. Anthropic (Claude 3.7 Sonnet / Haiku)
ANTHROPIC_API_KEY=

# 2. OpenAI (GPT-4o / GPT-4.5)
OPENAI_API_KEY=

# 3. Sovereign Local Ollama (100% Free & Private)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Active Workspace Root
AETHER_WORKSPACE_DIR=.

# Operational Mode ('development' | 'production' | 'mock')
AETHER_MODE=development
